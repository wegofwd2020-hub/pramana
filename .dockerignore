# Keep the build context small and keep non-runtime material out of the image.
.git
.github
.venv
**/__pycache__
**/*.pyc
.pytest_cache
.mypy_cache
.ruff_cache
htmlcov
.coverage*

# Tests and their fixtures are not runtime artifacts.
tests/

# docs/frameworks IS runtime data (the definitions library reads it), so the
# Dockerfile copies that subtree explicitly. Everything else under docs/ is not.
docs/api
docs/user-stories
docs/*.md

TICKETS/
assets/
*.md
!README.md
.env
.env.*
Dockerfile
compose.yaml
