# =============================================================================
# Pramana environment variables — copy this file to `.env` and fill in values.
# `.env` is gitignored. Never commit secrets.
# =============================================================================

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
ENVIRONMENT=development           # development | staging | production
LOG_LEVEL=DEBUG                   # DEBUG | INFO | WARNING | ERROR
SECRET_KEY=change-me-in-production-use-a-long-random-string

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://pramana:pramana@localhost:5432/pramana
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_ECHO=false
# The role the app connects as at runtime, when that is NOT the role owning the
# schema. Migration 0009 then narrows its rights on audit_log to SELECT/INSERT.
# Leave empty for a single-role deployment: a Postgres owner keeps its
# privileges regardless of REVOKE, so there is nothing to narrow. See
# SECURITY.md §3 and TICKETS/PR-1.
APP_DB_ROLE=

# -----------------------------------------------------------------------------
# Redis (Celery broker + result backend)
# -----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# -----------------------------------------------------------------------------
# Auth (SSO via SAML/OIDC — values per provider)
# -----------------------------------------------------------------------------
SSO_ISSUER_URL=https://your-idp.example.com
SSO_CLIENT_ID=
SSO_CLIENT_SECRET=
JWT_ALGORITHM=RS256
JWT_AUDIENCE=pramana

# -----------------------------------------------------------------------------
# Object storage (AWS S3 or compatible)
# -----------------------------------------------------------------------------
S3_BUCKET_VIDEO=pramana-video-dev
S3_BUCKET_CERTIFICATES=pramana-certs-dev
S3_BUCKET_AUDIT_ARCHIVE=pramana-audit-dev   # Object Lock recommended in prod
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# -----------------------------------------------------------------------------
# Email (SMTP for notifications — SES recommended in prod)
# -----------------------------------------------------------------------------
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=noreply@pramana.example.com

# -----------------------------------------------------------------------------
# Mentible handoff (ADR-011) — content commissioning and ingestion
# -----------------------------------------------------------------------------
# Shared secret verifying the HMAC-SHA256 signature on an incoming Consumable
# Package. Empty is refused at verification time, so ingestion fails closed
# rather than accepting unsigned packages — set this before enabling ingest.
MENTIBLE_PACKAGE_HMAC_SECRET=
# Separate secret for the inbound progress webhook. Deliberately distinct from
# the package secret so the two rotate independently.
MENTIBLE_WEBHOOK_HMAC_SECRET=
# Where Pramana pushes a Package Request. Empty → the Mentible client is a no-op
# stub, which is what dev and test want.
MENTIBLE_REQUEST_URL=

# -----------------------------------------------------------------------------
# Definitions library (the "law" picker — framework reference docs)
# -----------------------------------------------------------------------------
DEFINITIONS_ROOT=docs/frameworks

# -----------------------------------------------------------------------------
# LLM (quiz drafting from a clause — ADR-013)
# -----------------------------------------------------------------------------
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-4-6
LLM_API_KEY=
LLM_MAX_TOKENS=4096

# -----------------------------------------------------------------------------
# Video generation (wegofwd-video — ADR-026)
# -----------------------------------------------------------------------------
VIDEO_PROVIDER=veo
VIDEO_MODEL=veo-3.1
VIDEO_API_KEY=
VIDEO_RESOLUTION=1080p
VIDEO_ASPECT_RATIO=16:9
VIDEO_MIN_WATCH_PCT=0             # 0 = quiz unlocked immediately; raise to gate on watch

# -----------------------------------------------------------------------------
# Compliance defaults (overridable per course/tenant via DB)
# -----------------------------------------------------------------------------
DEFAULT_PASS_THRESHOLD_PCT=80
DEFAULT_COOLDOWN_DAYS=365
DEFAULT_MAX_ATTEMPTS=2
DEFAULT_RECORD_RETENTION_YEARS=7
